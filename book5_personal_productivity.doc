    .prompt-box { background-color: #F0FDF4; border: 1.5pt solid #BBF7D0; padding: 8pt 12pt; font-family: 'Consolas', monospace; font-size: 9.5pt; color: #0F172A; }
    .zine-grid { width: 100%; border-collapse: collapse; margin-top: 12pt; }
    .zine-grid td { width: 25%; height: 2.8in; border: 1pt dashed #94A3B8; padding: 8pt; vertical-align: top; background-color: #FFFFFF; }
    .cover-cell { background-color: #0F2E0F; color: #FFFFFF; }
    .page-tag { font-family: 'Consolas', monospace; font-size: 8pt; font-weight: bold; color: #64748B; border-bottom: 1pt solid #E2E8F0; padding-bottom: 2pt; margin-bottom: 4pt; }
    .cut-line { text-align: center; color: #DC2626; font-weight: bold; font-family: 'Consolas', monospace; font-size: 9pt; padding: 4pt 0; border-top: 2pt dashed #DC2626; margin: 8pt 0; }
  </style>
</head>
<body>
<div class="Section1">
